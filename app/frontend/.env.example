# API Gateway Endpoint (public entry point)
# If omitted or empty, requests fall back to '/api'
VITE_API_GATEWAY_URL=/api

# Discord Application Client ID for OAuth2 login
# If omitted, a mock Discord login is automatically used for local development/testing
VITE_DISCORD_CLIENT_ID=

# Firebase Project Configuration for direct Firestore onSnapshot listeners
# If omitted or unconfigured, the frontend falls back seamlessly to MockRealtimeProvider
VITE_FIREBASE_PROJECT_ID=teampasx-cloudnative-dev
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=teampasx-cloudnative-dev.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=teampasx-cloudnative-dev.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
