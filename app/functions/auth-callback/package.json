{
  "name": "auth-callback",
  "version": "1.0.0",
  "description": "Discord OAuth2 Login Callback Cloud Function (Issue #79 / C07 §3.1 & ADR-0009)",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc",
