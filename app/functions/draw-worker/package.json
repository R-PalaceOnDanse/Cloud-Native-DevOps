{
  "name": "draw-worker",
  "version": "1.0.0",
  "description": "Asynchronous Draw and Command Worker Cloud Function (Issues #48, #52, #53, #55, #56, #57, #141, #142 / C06 §4 & C07 §1)",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc",
