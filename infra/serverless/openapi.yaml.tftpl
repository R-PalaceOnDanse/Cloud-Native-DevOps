swagger: "2.0"
info:
  title: canvas-api
  description: Public entry point of the pixel canvas. Every route is checked here, then forwarded to a private function.
  version: "0.1.0"
schemes:
  - https
produces:
  - application/json

securityDefinitions:
  # The gateway refuses any request without a valid key for this API, before any function runs.
  api_key:
    type: apiKey
    name: x-api-key
    in: header
  # Firebase ID token of a signed-in web user (ADR-0009). The gateway checks signature, issuer,
  # audience and expiry, then forwards the claims to the function in X-Apigateway-Api-Userinfo.
  firebase:
    authorizationUrl: ""
    flow: implicit
    type: oauth2
    x-google-issuer: "https://securetoken.google.com/${project_id}"
    x-google-jwks_uri: "https://www.googleapis.com/service_accounts/v1/metadata/x509/securetoken@system.gserviceaccount.com"
    x-google-audiences: "${project_id}"

paths:
  /hello:
    get:
      operationId: hello
      summary: C05 demo, reads a value from Secret Manager.
      security:
        - api_key: []
      x-google-backend:
        # The gateway signs the call with an ID token of its service account, for this audience (Issue #133).
        address: ${hello_url}
        jwt_audience: ${hello_url}
        deadline: 10.0
      responses:
        "200":
          description: The function read its secret.
        "401":
          description: Missing or invalid API key.
  /draw:
    options:
      operationId: webDrawProxyCors
      summary: CORS preflight of the browser, answered by the function without authentication.
      x-google-backend:
        address: ${web_draw_proxy_url}
        jwt_audience: ${web_draw_proxy_url}
        deadline: 5.0
      responses:
        "204":
          description: Preflight accepted.
    post:
      operationId: webDrawProxy
      summary: Asynchronous pixel drawing endpoint for web clients (Issue #76)
      security:
        - firebase: []
      x-google-backend:
        address: ${web_draw_proxy_url}
        jwt_audience: ${web_draw_proxy_url}
        deadline: 15.0
      responses:
        "202":
          description: Accepted for asynchronous processing.
        "400":
          description: Invalid coordinates or batch.
        "401":
          description: Missing or invalid authentication token.
  /auth/discord/callback:
    options:
      operationId: authCallbackCors
      summary: CORS preflight of the browser.
      x-google-backend:
        address: ${auth_callback_url}
        jwt_audience: ${auth_callback_url}
        deadline: 5.0
      responses:
        "204":
          description: Preflight accepted.
    post:
      operationId: authCallback
      summary: Discord OAuth2 code exchange callback (Issue #79)
      x-google-backend:
        address: ${auth_callback_url}
        jwt_audience: ${auth_callback_url}
        deadline: 15.0
      responses:
        "200":
          description: Successfully authenticated.
        "400":
          description: Invalid code or CSRF state mismatch.
