swagger: "2.0"
info:
  title: canvas-api
  description: Public entry point of the pixel canvas. Every route is checked here, then forwarded to a private function.
  version: "0.1.0"
schemes:
  - https
produces:
  - application/json

securityDefinitions:
  # The gateway refuses any request without a valid key for this API, before any function runs.
  api_key:
    type: apiKey
    name: x-api-key
    in: header

paths:
  /hello:
    get:
      operationId: hello
      summary: C05 demo, reads a value from Secret Manager.
      security:
        - api_key: []
      x-google-backend:
        # The gateway signs the call with an ID token of its service account, for this audience.
        address: ${hello_url}
        deadline: 10.0
      responses:
        "200":
          description: The function read its secret.
        "401":
          description: Missing or invalid API key.
  /draw:
    post:
      operationId: webDrawProxy
      summary: Asynchronous pixel drawing endpoint for web clients (Issue #76)
      x-google-backend:
        address: ${web_draw_proxy_url}
        deadline: 15.0
      responses:
        "202":
          description: Accepted for asynchronous processing.
        "400":
          description: Invalid coordinates or batch.
        "401":
          description: Missing or invalid authentication token.
  /auth/discord/callback:
    post:
      operationId: authCallback
      summary: Discord OAuth2 code exchange callback (Issue #79)
      x-google-backend:
        address: ${auth_callback_url}
        deadline: 15.0
      responses:
        "200":
          description: Successfully authenticated.
        "400":
          description: Invalid code or CSRF state mismatch.
