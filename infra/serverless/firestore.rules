rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny: All collections are private by default
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Chunks collection (64x64 pixel tiles)
    // Fulfills Issue #84 & C07 §3.3:
    // - Authenticated users (Discord OAuth / Firebase custom token) may read.
    // - All client writes are strictly denied (all modifications must pass through Web Draw Proxy -> Pub/Sub -> Worker).
    match /chunks/{chunkId} {
      allow read: if request.auth != null;
      allow write: if false;

      // Delta documents subcollection
      match /deltas/{deltaId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // System configuration (e.g. pause state, admin clear)
    // Authenticated users can read configuration; writes strictly forbidden for clients.
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // User rate-limit token bucket records
    // Managed purely by server-side workers with Admin privileges; client access denied.
    match /ratelimits/{userId} {
      allow read, write: if false;
    }
  }
}
