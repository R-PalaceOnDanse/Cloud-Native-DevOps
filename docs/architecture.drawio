        <mxCell id="runnernote" value="Jobs with runs-on: vars.RUNNER_LABEL (arc-dev / arc-prd):&lt;br&gt;terraform-ci, functions-ci, frontend-ci, secret-scan.&lt;br&gt;Cluster autoscaler adds a Spot node per pending runner pod&lt;br&gt;and removes empty nodes (OPTIMIZE_UTILIZATION).&lt;br&gt;terraform-deploy / -run / -destroy stay on ubuntu-latest." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DADCE0;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
